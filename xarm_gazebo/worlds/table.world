<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="default">
  <plugin name="gazebo_ros" filename="libgazebo_ros_init.so">
    <ros><namespace>/</namespace></ros>
  </plugin>

  <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
    <ros>
      <namespace>/gazebo</namespace>
    </ros>
  </plugin>
  
  <!-- rest of your world -->


    <!-- Ground plane & sun -->
    <include><uri>model://ground_plane</uri></include>
    <include><uri>model://sun</uri></include>

    <!-- Table -->
    <include>
      <uri>model://customtable</uri>
      <name>custom_table</name>
      <pose>0.0 -0.84 0 0 0 0</pose>
    </include>

    <!-- Plate -->
    <!--<include>
      <uri>model://plate</uri>
      <name>custom_plate</name>
      <pose>0.03 -0.73 0.78 0 0 0</pose>
    </include>-->

    <!-- Blue cube directly on plate -->
    <model name="blue_cube">
      <static>false</static>
      <link name="blue_cube_link">
        <pose>0.03 -0.73 0.795 0 0 0</pose>
        <inertial><mass>0.05</mass></inertial>
        <collision name="collision">
          <geometry>
            <box><size>0.014 0.014 0.018</size></box>
          </geometry>
          <surface>
            <friction>
              <ode><mu>1.2</mu><mu2>1.2</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.014 0.014 0.018</size></box>
          </geometry>
          <material>
            <ambient>0 0 1 1</ambient>
            <diffuse>0 0 1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Grey open-top box -->
    <model name="grey_box">
      <pose>0.20 -0.75 0.790 0 0 0</pose>
      <static>true</static>

      <!-- Bottom -->
      <link name="bottom">
        <pose>0 0 0 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.1 0.1 0.01</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 0.1 0.01</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
      </link>

      <!-- Wall 1 -->
      <link name="wall1">
        <pose>0 0.045 0.03 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.1 0.01 0.06</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 0.01 0.06</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
      </link>

      <!-- Wall 2 -->
      <link name="wall2">
        <pose>0 -0.045 0.03 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.1 0.01 0.06</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 0.01 0.06</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
      </link>

      <!-- Wall 3 -->
      <link name="wall3">
        <pose>0.045 0 0.03 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.01 0.1 0.06</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.01 0.1 0.06</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
      </link>

      <!-- Wall 4 -->
      <link name="wall4">
        <pose>-0.045 0 0.03 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.01 0.1 0.06</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.01 0.1 0.06</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
      </link>

      <!-- Fixed joints -->
      <joint name="wall1_joint" type="fixed"><parent>bottom</parent><child>wall1</child></joint>
      <joint name="wall2_joint" type="fixed"><parent>bottom</parent><child>wall2</child></joint>
      <joint name="wall3_joint" type="fixed"><parent>bottom</parent><child>wall3</child></joint>
      <joint name="wall4_joint" type="fixed"><parent>bottom</parent><child>wall4</child></joint>
    </model>

    <!-- Front environment RGB camera -->
    <model name="front_env_camera">
      <static>true</static>
      <pose>0 -0.87 0.835 0 0 1.5708</pose>
      <link name="front_camera_link">
        <inertial><mass>0.001</mass></inertial>
        <collision name="collision">
          <geometry><box><size>0.01 0.01 0.01</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
            <transparency>1.0</transparency>
          </material>
        </visual>

        <sensor name="front_rgb" type="camera">
          <always_on>1</always_on>
          <update_rate>30</update_rate>
          <visualize>true</visualize>
          <camera name="camera">
            <horizontal_fov>1.5708</horizontal_fov>
            <image>
              <width>1280</width>
              <height>720</height>
              <format>R8G8B8</format>
            </image>
            <clip><near>0.05</near><far>50</far></clip>
          </camera>
          <plugin name="front_rgb_controller" filename="libgazebo_ros_camera.so">
            <ros>
              <namespace>/front_camera</namespace>
            </ros>
            <camera_name>front_camera</camera_name>
            <frame_name>front_camera_optical_frame</frame_name>
          </plugin>
        </sensor>
      </link>
    </model>
  </world>
</sdf>
