<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">


    <!-- 1) Grasp-fix plugin for pick-and-place -->
  <xacro:macro name="lite_gazebo_grasp_fix" params="prefix:='' arm_name:='lite_gripper' palm_link:='lite_gripper_base_link' ">
    <gazebo>
      
      <plugin name="gazebo_grasp_fix" filename="libgazebo_grasp_fix.so">
        <arm>
          <arm_name>${arm_name}</arm_name>
          <palm_link>${prefix}${palm_link}</palm_link>
          <gripper_link>${prefix}left_finger_link</gripper_link>
          <gripper_link>${prefix}right_finger_link</gripper_link>
        </arm>
        <forces_angle_tolerance>100</forces_angle_tolerance>
        <update_rate>10</update_rate>
        <grip_count_threshold>2</grip_count_threshold>
        <max_grip_count>3</max_grip_count>
        <release_tolerance>0.0198</release_tolerance>
        <disable_collisions_on_attach>false</disable_collisions_on_attach>
        <contact_topic>__default_topic__</contact_topic>
      </plugin>
    </gazebo>
  </xacro:macro>

  
  <xacro:macro name="lite_gripper_gazebo" params="prefix">
  
    <gazebo reference="${prefix}lite_gripper_base_link">
      <selfCollide>false</selfCollide>
    </gazebo>

    <gazebo reference="${prefix}left_finger_link">
      <selfCollide>false</selfCollide>
    </gazebo>

    <gazebo reference="${prefix}right_finger_link">
      <selfCollide>false</selfCollide>
    </gazebo>

  </xacro:macro>  

</robot>
